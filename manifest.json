{
  "manifest_version": 2,
  "name": "YT Full Captions",
  "version": "1.0.0",
  "description": "Shows YouTube auto-generated captions line by line, like normal subtitles, instead of word by word.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*"
  ],
  "background": {
    "scripts": ["transform.js", "background.js"]
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "YT Full Captions",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-full-captions@kabax04.github.io",
      "strict_min_version": "91.0"
    }
  }
}
